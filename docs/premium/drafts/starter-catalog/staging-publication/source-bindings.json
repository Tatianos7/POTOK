        "steps": [
          {
            "stepRowId": "chicken_bulgur_zucchini_step_01",
            "stepOrder": 1,
            "instruction": "Промыть 140 г сухого medium/coarse булгура, добавить ровно 280 мл воды, довести до кипения и готовить под крышкой 12–15 минут до впитывания; оставить на 5 минут.",
            "durationMinutes": 20,
            "temperatureCelsius": null
          },
          {
            "stepRowId": "chicken_bulgur_zucchini_step_02",
            "stepOrder": 2,
            "instruction": "Обсушить и взвесить 300 г сырой куриной грудки без кожи; нарезать 2–3 см. Нарезать 300 г сырого кабачка кубиком 1.5 см.",
            "durationMinutes": null,
            "temperatureCelsius": null
          },
          {
            "stepRowId": "chicken_bulgur_zucchini_step_03",
            "stepOrder": 3,
            "instruction": "Разогреть 5 г масла, готовить курицу 5–7 минут, затем переложить на чистую тарелку до финального соединения.",
            "durationMinutes": 7,
            "temperatureCelsius": null
          },
          {
            "stepRowId": "chicken_bulgur_zucchini_step_04",
            "stepOrder": 4,
            "instruction": "Добавить оставшиеся 5 г масла и кабачок; готовить без крышки 6–8 минут до мягкости и испарения поверхностной жидкости.",
            "durationMinutes": 8,
            "temperatureCelsius": null
          },
          {
            "stepRowId": "chicken_bulgur_zucchini_step_05",
            "stepOrder": 5,
            "instruction": "Вернуть курицу, довести до безопасной готовности, смешать с булгуром и прогреть 1–2 минуты. Не добавлять бульон или соус.",
            "durationMinutes": 2,
            "temperatureCelsius": null
          }
        ],
