        "steps": [
          {
            "stepRowId": "beef_patties_roasted_carrot_step_01",
            "stepOrder": 1,
            "instruction": "Разогреть духовку до 210°C. Нарезать 500 г моркови одинаковыми брусочками, смешать с ровно 7 г масла и 1 г соли; запекать около 25–30 минут, один раз перевернуть.",
            "durationMinutes": null,
            "temperatureCelsius": null
          },
          {
            "stepRowId": "beef_patties_roasted_carrot_step_02",
            "stepOrder": 2,
            "instruction": "Осторожно смешать 300 г нежирного говяжьего фарша только с 1 г соли. Сырая смесь котлет — 301 г; не добавлять лук, яйцо, сухари, молоко или жидкость.",
            "durationMinutes": null,
            "temperatureCelsius": null
          },
          {
            "stepRowId": "beef_patties_roasted_carrot_step_03",
            "stepOrder": 3,
            "instruction": "Сформовать ровно 2 котлеты, ориентир 150,5 г каждая. Использовать оставшиеся 3 г масла на антипригарной сковороде.",
            "durationMinutes": null,
            "temperatureCelsius": null
          },
          {
            "stepRowId": "beef_patties_roasted_carrot_step_04",
            "stepOrder": 4,
            "instruction": "Готовить котлеты с двух сторон до температуры в центре минимум 71°C; кратко дать отдохнуть. Не добавлять соус или масло.",
            "durationMinutes": null,
            "temperatureCelsius": null
          },
          {
            "stepRowId": "beef_patties_roasted_carrot_step_05",
            "stepOrder": 5,
            "instruction": "Взвесить отдельно две готовые котлеты и морковь; одна котлета и половина моркови образуют порцию.",
            "durationMinutes": null,
            "temperatureCelsius": null
          }
        ],
